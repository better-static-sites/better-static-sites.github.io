---
export interface AdmonitionTypeConfig {
  label: string;
  color: string;
  icon?: { viewBox: string; d: string };
}

export const DEFAULT_TYPES: Record<string, AdmonitionTypeConfig> = {
  note: {
    label: 'Note',
    color: '#3b82f6',
    icon: {
      viewBox: '0 0 18 18',
      d: 'M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0114.25 14H1.75A1.75 1.75 0 010 12.25v-8.5zm1.75-.25a.25.25 0 00-.25.25v8.5c0 .138.112.25.25.25h12.5a.25.25 0 00.25-.25v-8.5a.25.25 0 00-.25-.25H1.75zM3.5 6.25a.75.75 0 01.75-.75h7a.75.75 0 010 1.5h-7a.75.75 0 01-.75-.75zm.75 2.25a.75.75 0 000 1.5h4a.75.75 0 000-1.5h-4z',
    },
  },
  tip: {
    label: 'Tip',
    color: '#16a34a',
    icon: {
      viewBox: '0 0 18 18',
      d: 'M14 0a8.8 8.8 0 0 0-6 2.6l-.5.4-.9 1H3.3a1.8 1.8 0 0 0-1.5.8L.1 7.6a.8.8 0 0 0 .4 1.1l3.1 1 .2.1 2.4 2.4.1.2 1 3a.8.8 0 0 0 1 .5l2.9-1.7a1.8 1.8 0 0 0 .8-1.5V9.5l1-1 .4-.4A8.8 8.8 0 0 0 16 2v-.1A1.8 1.8 0 0 0 14.2 0h-.1zm-3.5 10.6-.3.2L8 12.3l.5 1.8 2-1.2a.3.3 0 0 0 .1-.2v-2zM3.7 8.1l1.5-2.3.2-.3h-2a.3.3 0 0 0-.3.1l-1.2 2 1.8.5zm5.2-4.5a7.3 7.3 0 0 1 5.2-2.1h.1a.3.3 0 0 1 .3.3v.1a7.3 7.3 0 0 1-2.1 5.2l-.5.4a15.2 15.2 0 0 1-2.5 2L7.1 11 5 9l1.5-2.3a15.3 15.3 0 0 1 2-2.5l.4-.5zM12 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-8.4 9.6a1.5 1.5 0 1 0-2.2-2.2 7 7 0 0 0-1.1 3 .2.2 0 0 0 .3.3c.6 0 2.2-.4 3-1.1z',
    },
  },
  caution: {
    label: 'Caution',
    color: '#ca8a04',
    icon: {
      viewBox: '-1 1 18 18',
      d: 'M8.9 1.5C8.7 1.2 8.4 1 8 1s-.7.2-.9.5l-7 12a1 1 0 0 0 0 1c.2.3.6.5 1 .5H15c.4 0 .7-.2.9-.5a1 1 0 0 0 0-1l-7-12zM9 13H7v-2h2v2zm0-3H7V6h2v4z',
    },
  },
  danger: {
    label: 'Danger',
    color: '#dc2626',
    icon: {
      viewBox: '0 1 14 17',
      d: 'M5 .3c.9 2.2.5 3.4-.5 4.3C3.5 5.6 2 6.5 1 8c-1.5 2-1.7 6.5 3.5 7.7-2.2-1.2-2.6-4.5-.3-6.6-.6 2 .6 3.3 2 2.8 1.4-.4 2.3.6 2.2 1.7 0 .8-.3 1.4-1 1.8A5.6 5.6 0 0 0 12 10c0-2.9-2.5-3.3-1.3-5.7-1.5.2-2 1.2-1.8 2.8 0 1-1 1.8-2 1.3-.6-.4-.6-1.2 0-1.8C8.2 5.3 8.7 2.5 5 .3z',
    },
  },
};

export interface Props {
  type?: string;
  title?: string;
  types?: Record<string, AdmonitionTypeConfig>;
  display?: 'block' | 'inline' | 'auto';
  titleBold?: boolean;
  renderif?: boolean;
  class?: string;
}

const {
  type = 'note',
  title,
  types = {},
  display = 'block',
  titleBold = true,
  renderif = true,
  class: extraClass = '',
} = Astro.props as Props;

const allTypes = { ...DEFAULT_TYPES, ...types };
const config = allTypes[type] ?? {
  label: type.charAt(0).toUpperCase() + type.slice(1).replace(/-/g, ' '),
  color: '#71717a',
};
const resolvedTitle = title ?? config.label;

// a title string may use inline markdown: `code`, **bold** or __bold__, *italic* or _italic_
const escapeHtml = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
function renderInline(text: string, html: boolean) {
  const codes: string[] = [];
  // set code spans aside so their contents stay literal
  let out = text.replace(/`([^`]+)`/g, (_, code) => `\u0000${codes.push(code) - 1}\u0000`);
  if (html) out = escapeHtml(out);
  const wrap = (tag: string) => (_: string, pre: string, inner: string) => pre + (html ? `<${tag}>${inner}</${tag}>` : inner);
  out = out
    .replace(/(^|[^*])\*\*([^*]+)\*\*/g, wrap('strong'))
    .replace(/(^|[^\w])__([^_]+)__(?!\w)/g, wrap('strong'))
    .replace(/(^|[^*])\*([^*]+)\*/g, wrap('em'))
    .replace(/(^|[^\w])_([^_]+)_(?!\w)/g, wrap('em'));
  return out.replace(/\u0000(\d+)\u0000/g, (_, i) => (html ? `<code>${escapeHtml(codes[i])}</code>` : codes[i]));
}
const titleHtml = renderInline(resolvedTitle, true);
const titleText = renderInline(resolvedTitle, false);
const hasDefaultSlot = Astro.slots.has('default');
const hasTitleSlot = Astro.slots.has('title');

// auto: badge when no content slot, callout when has content slot
const isBlock = display === 'block' || (display === 'auto' && hasDefaultSlot);
---

{renderif && (
  isBlock ? (
    <div
      role="note"
      aria-label={titleText}
      class:list={['admonition', `admonition-type-${type}`, extraClass]}
      style={`--admonition-color: ${config.color}`}
    >
      <div class:list={['admonition-title', titleBold && 'admonition-title-bold']}>
        {config.icon && (
          <span class="admonition-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox={config.icon.viewBox} width="24" height="24">
              <path fill-rule="evenodd" d={config.icon.d} />
            </svg>
          </span>
        )}
        {hasTitleSlot ? <slot name="title" /> : <span set:html={titleHtml} />}
      </div>
      {hasDefaultSlot && (
        <div class="admonition-content">
          <slot />
        </div>
      )}
    </div>
  ) : (
    <span
      role="note"
      class:list={['admonition-badge', `admonition-badge-${type}`, extraClass]}
      style={`--admonition-color: ${config.color}`}
    >
      {hasTitleSlot ? <slot name="title" /> : <Fragment set:html={titleHtml} />}
    </span>
  )
)}
