  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-static-sites/better-static-sites.github.io.git",
    "directory": "lib/glossary"
  },
  "homepage": "https://better-static-sites.github.io",
  "bugs": {
    "url": "https://github.com/better-static-sites/better-static-sites.github.io/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./remark": "./src/remark.mjs",
    "./satteri": "./src/satteri.mjs",
    "./data": "./src/data.mjs",
    "./GlossaryTerm.astro": "./GlossaryTerm.astro",
    "./Glossary.astro": "./Glossary.astro",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "index.mjs",
