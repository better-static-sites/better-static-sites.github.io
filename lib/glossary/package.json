    "marked": "^17.0.0 || ^18.0.0",
    "unist-util-visit-parents": "^6.0.1"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "satteri": ">=0.10.0 <0.11.0"
  },
  "peerDependenciesMeta": {
    "satteri": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "satteri": "^0.10.5"
  }
