---
import { Marked } from "marked";

interface Props {
  label: string;
}

const { label } = Astro.props;

const id = `tab-${Math.random().toString(36).substring(2, 9)}`;

const remark = new Marked();
const markdownifiedLabel = remark.parseInline(label);
---

<div class="tab-bar-item">
  <input
    type="radio"
    name="%%TAB_GROUP%%"
    id={id}
    class="tab-input sr-only"
  />

  <label
    for={id}
    class="tab-label px-4 py-1.5 my-1 text-sm font-medium cursor-pointer transition-all"
  >
    <span set:html={markdownifiedLabel} />
  </label>
</div>

<div class="tab-panel">
  <slot />
</div>

<style is:global>
  @reference "tailwindcss";

  /* container */
  .tabs-group {
    @apply my-8 border rounded-md overflow-hidden;
    border-color: var(--tabs-border, #e5e7eb);
    background-color: var(--tabs-bg, #e5e7eb);
  }

  /* scrollable tab bar */
  .tab-bar {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: thin;
    align-items: stretch;
    gap: 0.25rem;
    background-color: var(--tabs-bg, #e5e7eb);
  }

  /* styles for text and bg color set with high specificity to beat CSS inheritance */
  .tab-bar .tab-input:not(:checked) + .tab-label,
  .tab-bar .tab-input:not(:checked) + .tab-label span {
    color: #4b5563 !important;
  }

  .tab-bar .tab-input:not(:checked) + .tab-label:hover,
  .tab-bar .tab-input:not(:checked) + .tab-label:hover span {
    color: #445599 !important;
  }

  .tab-bar .tab-input:not(:checked) + .tab-label:hover,
  .tab-bar .tab-input:not(:checked) + .tab-label:hover {
    background-color: #CCCCCC !important;
  }

  html.dark .tab-bar .tab-input:not(:checked) + .tab-label:hover,
  html.dark .tab-bar .tab-input:not(:checked) + .tab-label:hover span {
    color: #ffffff !important;
  }

  html.dark .tab-bar .tab-input:not(:checked) + .tab-label:hover,
  html.dark .tab-bar .tab-input:not(:checked) + .tab-label:hover {
    background-color: #888899 !important;
  }

  html.dark .tab-bar .tab-input:not(:checked) + .tab-label,
  html.dark .tab-bar .tab-input:not(:checked) + .tab-label span {
    color: #94a3b8 !important;
  }

  html.dark .tab-bar .tab-input:checked + .tab-label span {
    color: var(--tabs-active-color, #e2e8f0) !important;
  }

  /* panels hidden by default; :has() shows the active one */
  .tab-panel {
    display: none;
    width: 100%;
    padding: 5px 5px 2px;
    background-color: var(--tabs-panel-bg, #ffffff);
  }

  /* panel switching via :has(), direct-child combinators prevent outer rules from firing on nested groups */
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(1):checked) > .tab-panel:nth-of-type(1) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(2):checked) > .tab-panel:nth-of-type(2) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(3):checked) > .tab-panel:nth-of-type(3) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(4):checked) > .tab-panel:nth-of-type(4) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(5):checked) > .tab-panel:nth-of-type(5) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(6):checked) > .tab-panel:nth-of-type(6) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(7):checked) > .tab-panel:nth-of-type(7) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(8):checked) > .tab-panel:nth-of-type(8) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(9):checked) > .tab-panel:nth-of-type(9) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(10):checked) > .tab-panel:nth-of-type(10) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(11):checked) > .tab-panel:nth-of-type(11) { display: block; }
  .tabs-group:has(> .tab-bar > .tab-input:nth-of-type(12):checked) > .tab-panel:nth-of-type(12) { display: block; }

  /* 0.25rem < container's rounded-md (0.375rem): label bg covers the container's clip area */
  /* flex-grow: 1 fills remaining bar space, no separate spacer needed */
  .tab-label {
    border-radius: 0.25rem 0.25rem 0 0;
    flex-grow: 1;
  }

  /* strip bottom margin from nested tab groups, the panel's pb handles spacing */
  .tab-panel .tabs-group { margin-bottom: 0; }

  .tab-input:checked + .tab-label {
    @apply font-bold;
    background-color: var(--tabs-active-bg, #ffffff);
    color: var(--tabs-active-color, #111827);
    margin-top: 0;
    margin-bottom: 0;
  }

</style>
