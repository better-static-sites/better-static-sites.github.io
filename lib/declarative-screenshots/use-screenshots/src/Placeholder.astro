---
// stands in for a screenshot PNG that take-screenshots hasn't written yet
interface Props {
  name: string;
  label: string;
  width: number;
  height: number;
  framed?: boolean;
  // a crop's size isn't known until capture, so the box sizes to its text
  cropped?: boolean;
}

const { name, label, width, height, framed = false, cropped = false } = Astro.props;
---

<div
  class:list={['sc-placeholder', 'screenshot-placeholder', { 'sc-placeholder-framed': framed }]}
  role="img"
  aria-label={label}
  style={cropped ? undefined : `aspect-ratio:${width} / ${height}`}
>
  <svg class="sc-placeholder-icon" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="8.5" cy="9.5" r="1.5" fill="currentColor" />
    <path d="M4 18l5-5 3 3 3-3 5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
  <p class="sc-placeholder-title">Screenshot not generated yet</p>
  <code class="sc-placeholder-name">{name}.png</code>
  <p class="sc-placeholder-hint">Run <code>take-screenshots</code> to generate the image.</p>
</div>

<style>
  .sc-placeholder {
    --sc-ph-bg: #f6f7f9;
    --sc-ph-stripe: #eef0f3;
    --sc-ph-text: #3c4149;
    --sc-ph-muted: #6b7280;
    --sc-ph-code-bg: #ffffff;
    --sc-ph-border: #d6d9de;
    box-sizing: border-box;
    width: 100%;
    min-height: 12rem;
    max-height: 32rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem;
    background: repeating-linear-gradient(-45deg, var(--sc-ph-bg) 0 12px, var(--sc-ph-stripe) 12px 24px);
    color: var(--sc-ph-text);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
  }

  .sc-placeholder-framed {
    border: 1px dashed var(--sc-ph-border);
    border-radius: 8px;
  }

  .sc-placeholder-icon { flex-shrink: 0; color: var(--sc-ph-muted); }

  .sc-placeholder p { margin: 0; }

  .sc-placeholder-title { font-weight: 600; }

  .sc-placeholder-hint { color: var(--sc-ph-muted); }

  .sc-placeholder code {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.8125rem;
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--sc-ph-border);
    border-radius: 4px;
    background: var(--sc-ph-code-bg);
    overflow-wrap: anywhere;
  }

  /* same dark triggers as the window chrome */
  :global(:root[data-theme="dark"]) .sc-placeholder,
  :global(:root.dark) .sc-placeholder {
    --sc-ph-bg: #1e2127;
    --sc-ph-stripe: #23262d;
    --sc-ph-text: #e3e5e8;
    --sc-ph-muted: #9aa1ab;
    --sc-ph-code-bg: #2a2e35;
    --sc-ph-border: #3a3f47;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"]):not(.light) [data-sc-media]) .sc-placeholder {
      --sc-ph-bg: #1e2127;
      --sc-ph-stripe: #23262d;
      --sc-ph-text: #e3e5e8;
      --sc-ph-muted: #9aa1ab;
      --sc-ph-code-bg: #2a2e35;
      --sc-ph-border: #3a3f47;
    }
  }
</style>
