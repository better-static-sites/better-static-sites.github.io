---
import { getCollection, render } from 'astro:content';
import DocLayout from 'src/layouts/DocLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs
    .filter(entry => !/^index(\.(md|mdx))?$/i.test(entry.id))
    .map(entry => {
      const slug = entry.id.replace(/\.(md|mdx)$/i, '');
      return {
        params: { slug },
        props: { entry },
      };
    });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// don't expose the MD button for route:false folder indexes (no companion file is generated)
const entryId = entry.data.route === false ? undefined : entry.id;
---
<DocLayout title={entry.data.title} description={entry.data.description} entryId={entryId}>
  <Content />
</DocLayout>
