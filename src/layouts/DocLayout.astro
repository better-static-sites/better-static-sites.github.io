---
import { NavBar } from 'astro-better-nav-bar';
import Sidebar from 'astro-better-docs-sidebar/Sidebar.astro';
import TOC from 'astro-toc-smol/TOC.astro';
import CopyCodeButton from 'astro-better-code-blocks/CopyCodeButton.astro';
import 'src/css/style.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  entryId?: string;
}

const GITHUB_REPO = 'https://github.com/lambdalatitudinarians/bss-docs';

const { title, description, entryId } = Astro.props;

const slug = entryId ? entryId.replace(/\.(md|mdx)$/i, '') : null;
const editUrl  = entryId ? `${GITHUB_REPO}/edit/main/src/content/docs/${entryId}` : null;
const mdUrl    = slug ? `/docs/${slug}.md` : null;

const docsCollection = await getCollection('docs');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Better Static Sites</title>
    {description && <meta name="description" content={description} />}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="shortcut icon" href="/favicon.ico">
  </head>
  <body class="page-wrapper">
    <NavBar
      sectionTitle="Better Static Sites"
      sectionTitleHref="/"
      showThemeSelector
      showSearch={false}
    >
      <img slot="logo" src="/favicon-32x32.png" width="32" height="32" alt="" />
    </NavBar>
    <CopyCodeButton />

    <div class="doc-layout">
      <aside class="doc-sidebar">
        <Sidebar
          frontmatter={Astro.props}
          collection={docsCollection}
          basePath="/docs"
        />
        <nav class="sidebar-extra-nav">
          <a
            href="/release-notes"
            class:list={['sidebar-extra-link', { 'sidebar-extra-link--active': Astro.url.pathname === '/release-notes' }]}
          >
            Release Notes
          </a>
        </nav>
      </aside>

      <main class="doc-main">
        {entryId && (
          <div class="doc-actions">
            <!-- desktop row -->
            <div class="doc-actions-row">
              {editUrl && (
                <a href={editUrl} target="_blank" rel="noopener" class="doc-action" title="Edit this page on GitHub">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.013 1.427a1.75 1.75 0 012.474 0l1.086 1.086a1.75 1.75 0 010 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 01-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61zm1.414 1.06a.25.25 0 00-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 000-.354l-1.086-1.086zM11.189 6.25L9.75 4.811 4.351 10.21a.25.25 0 00-.065.108l-.558 1.953 1.953-.558a.25.25 0 00.108-.065l5.4-5.398z"/></svg>
                  <span>Edit</span>
                </a>
              )}
              {mdUrl && (
                <a href={mdUrl} class="doc-action" title="View Markdown source">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0113.25 16h-9.5A1.75 1.75 0 012 14.25V1.75zm1.75-.25a.25.25 0 00-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 00.25-.25V6h-2.75A1.75 1.75 0 019 4.25V1.5H3.75zm6.75.96V4.25c0 .138.112.25.25.25h2.04L10.5 2.46z"/></svg>
                  <span>MD</span>
                </a>
              )}
              {mdUrl && (
                <button class="copy-md-btn doc-action" data-md-url={mdUrl} title="Copy page as Markdown">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.75 1a.75.75 0 00-.75.75v3c0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75v-3a.75.75 0 00-.75-.75h-4.5zm.75 3V2.5h3V4h-3zm-2.874-.467a.75.75 0 00-.752-1.298A1.75 1.75 0 002 3.75v9.5c0 .966.784 1.75 1.75 1.75h8.5A1.75 1.75 0 0014 13.25v-9.5a1.75 1.75 0 00-.874-1.515.75.75 0 10-.752 1.298.25.25 0 01.126.217v9.5a.25.25 0 01-.25.25h-8.5a.25.25 0 01-.25-.25v-9.5a.25.25 0 01.126-.217z"/></svg>
                  <span>Copy</span>
                </button>
              )}
            </div>
            <!-- mobile hamburger -->
            <details class="doc-actions-menu">
              <summary class="doc-action" title="Page actions">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1 2.75A.75.75 0 011.75 2h12.5a.75.75 0 010 1.5H1.75A.75.75 0 011 2.75zm0 5A.75.75 0 011.75 7h12.5a.75.75 0 010 1.5H1.75A.75.75 0 011 7.75zm0 5a.75.75 0 01.75-.75h12.5a.75.75 0 010 1.5H1.75a.75.75 0 01-.75-.75z"/></svg>
              </summary>
              <div class="doc-actions-dropdown">
                {editUrl && <a href={editUrl} target="_blank" rel="noopener">Edit on GitHub</a>}
                {mdUrl && <a href={mdUrl}>Link to Markdown</a>}
                {mdUrl && <button class="copy-md-btn" data-md-url={mdUrl}>Copy as Markdown</button>}
              </div>
            </details>
          </div>
        )}
        <article class="prose">
          <slot />
        </article>
      </main>

      <aside class="doc-toc" data-toc-aside>
        <p class="toc-heading">On This Page</p>
        <TOC />
      </aside>
    </div>

    <footer class="site-footer">
      <p>Better Static Sites &mdash; built with <a href="https://astro.build">Astro</a></p>
    </footer>

    <script>
      document.querySelectorAll<HTMLButtonElement>('.copy-md-btn').forEach(btn => {
        const originalHTML = btn.innerHTML;
        btn.addEventListener('click', async () => {
          const url = btn.dataset.mdUrl;
          if (!url) return;
          try {
            const text = await fetch(url).then(r => r.text());
            await navigator.clipboard.writeText(text);
            btn.classList.add('copied');
            const span = btn.querySelector('span');
            if (span) span.textContent = 'Copied!';
            setTimeout(() => {
              btn.classList.remove('copied');
              if (span) span.textContent = 'Copy';
            }, 2000);
          } catch {
            const span = btn.querySelector('span');
            if (span) span.textContent = 'Failed';
            setTimeout(() => { if (span) span.textContent = 'Copy'; }, 2000);
          }
        });
      });
    </script>
  </body>
</html>
