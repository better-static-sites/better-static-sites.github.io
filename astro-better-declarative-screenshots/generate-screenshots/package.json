{
  "name": "astro-better-generate-screenshots",
  "version": "0.4.4",
  "description": "CLI that generates screenshot PNGs for astro-better-declarative-screenshots",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-static-sites/better-static-sites.github.io.git",
    "directory": "astro-better-declarative-screenshots/generate-screenshots"
  },
  "homepage": "https://better-static-sites.github.io",
  "bugs": {
    "url": "https://github.com/better-static-sites/better-static-sites.github.io/issues"
  },
  "type": "module",
  "bin": {
    "take-screenshots": "./scripts/take-screenshots.mjs",
    "check-screenshots": "./scripts/check-screenshots.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./scripts/take-screenshots.mjs": "./scripts/take-screenshots.mjs",
    "./scripts/check-screenshots.mjs": "./scripts/check-screenshots.mjs"
  },
  "files": [
    "index.mjs",
    "src/",
    "scripts/"
  ],
  "dependencies": {
    "playwright": "^1.45.0",
    "sharp": "^0.33.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "glob": "^11.0.0",
    "zod": "^3.23.0",
    "astro-better-declarative-screenshots": "^0.4.1"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  }
}
