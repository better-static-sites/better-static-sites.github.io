---
/**
 * Loads a code file from disk and renders it with Prism.
 * Supports two file conventions:
 *   - Bluehawk snippets: paths containing ".snippet." are resolved relative to snippetRoot
 *   - Whole files: resolved relative to snippetRoot, where the integration writes a copy with
 *     Bluehawk markup removed. Files the integration ignored fall back to sourceRoot.
 */

import { Prism } from '@astrojs/prism';
import fs from 'fs';
import path from 'path';
import { resolveExtractedCodePath } from './resolve.js';

interface Props {
  /** Path to the file, relative to the source project root. Paths containing ".snippet." name a Bluehawk snippet. */
  src: string;
  /** Prism language identifier. Defaults to "plaintext". */
  lang?: string;
  /** Optional title shown above the code block as a .code-title tab. */
  title?: string;
  /**
   * Root directory for Bluehawk-generated snippets and processed whole files.
   * @default path.join(process.cwd(), 'src', 'generated-code-snippets')
   */
  snippetRoot?: string;
  /**
   * Root directory for raw source files, used for whole files the integration ignored.
   * @default path.join(process.cwd(), 'extractedcode')
   */
  sourceRoot?: string;
}

const {
  src,
  lang = 'plaintext',
  title,
  snippetRoot = path.join(process.cwd(), 'src', 'generated-code-snippets'),
  sourceRoot = path.join(process.cwd(), 'extractedcode'),
} = Astro.props;

const filePath = resolveExtractedCodePath(src, snippetRoot, sourceRoot);

let code = '';
try {
  code = fs.readFileSync(filePath, 'utf-8').trim();
} catch (err) {
  throw new Error(
    `[astro-better-code-snippet-extractor] Could not read ${filePath}: ${(err as Error).message}`
  );
}
---

{title ? (
  <figure class="code-figure">
    <figcaption class="code-title">{title}</figcaption>
    <Prism code={code} lang={lang} />
  </figure>
) : (
  <Prism code={code} lang={lang} />
)}
