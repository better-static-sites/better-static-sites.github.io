{
  "name": "astro-better-toc",
  "version": "1.2.1",
  "description": "Astro integration + component for a full server-side 'On This Page' TOC with scroll spy",
  "keywords": [
    "astro",
    "astro-component",
    "astro-integration",
    "toc",
    "table-of-contents",
    "scroll-spy",
    "on-this-page"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-static-sites/better-static-sites.github.io.git",
    "directory": "astro-better-toc"
  },
  "homepage": "https://better-static-sites.github.io",
  "bugs": {
    "url": "https://github.com/better-static-sites/better-static-sites.github.io/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./TOC.astro": {
      "import": "./src/TOC.astro",
      "default": "./src/TOC.astro"
    },
    "./InlineTOC.astro": {
      "import": "./src/InlineTOC.astro",
      "default": "./src/InlineTOC.astro"
    }
  },
  "files": [
    "src/index.js",
    "src/process.js",
    "src/worker.js",
    "src/TOC.astro",
    "src/InlineTOC.astro"
  ],
  "scripts": {
    "test": "node --test src/index.test.js"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  }
}
